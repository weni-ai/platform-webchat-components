{
  "name": "@weni/platform-webchat-components",
  "version": "1.0.0",
  "description": "Vue component library for webchat experiences inside the VTEX CX Platform",
  "type": "module",
  "license": "MIT",
  "author": "Weni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weni-ai/platform-webchat-components.git"
  },
  "bugs": {
    "url": "https://github.com/weni-ai/platform-webchat-components/issues"
  },
  "homepage": "https://github.com/weni-ai/platform-webchat-components#readme",
  "engines": {
    "node": ">=26.0.0"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "@weni/unnnic-system": ">=3.30.0 <4",
    "@weni/webchat-service": "^1.10.3",
    "vue": "^3.4.8"
  },
  "peerDependenciesMeta": {
    "@weni/webchat-service": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "marked": "^16.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/vue3-vite": "^10.2.10",
    "@types/node": "^24.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-istanbul": "3.2.4",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@weni/eslint-config": "^2.0.0",
    "@weni/unnnic-system": "^3.30.0",
    "@weni/webchat-service": "^1.10.3",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "10.4.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.89.2",
    "storybook": "^10.2.10",
    "typescript": "~5.8.0",
    "vite": "6.3.6",
    "vitest": "3.2.4",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.11",
    "vue-tsc": "^3.0.5"
  }
}
